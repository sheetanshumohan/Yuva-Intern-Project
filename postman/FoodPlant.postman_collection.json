      "item": [
        {
          "name": "login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "description": "Exchange credentials for signed JWT\nRequired role: PUBLIC",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@foodplant.local\",\n  \"password\": \"YOUR_ADMIN_PASSWORD\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set(\"token\", pm.response.json().accessToken);",
                  "}"
